{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译当前 C 文件 (gcc)",
            "type": "cppbuild",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "用 gcc 编译当前打开的 .c 文件"
        },
        {
            "label": "编译并运行当前 C 文件",
            "type": "shell",
            "command": "& \"${fileDirname}\\${fileBasenameNoExtension}.exe\"",
            "dependsOn": [
                "编译当前 C 文件 (gcc)"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "detail": "先编译，再运行生成的 .exe"
        }
    ]
}
